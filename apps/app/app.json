{
  "expo": {
    "name": "Dương Sinh Chess",
    "slug": "duongsinh-chess",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "duongsinh",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F9FC",
    "ios": {
      "bundleIdentifier": "vn.duongsinh.chess",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.duongsinh.chess",
      "adaptiveIcon": {
        "backgroundColor": "#2B3990",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Dương Sinh Chess — Vui trí tuệ",
      "shortName": "Dương Sinh",
      "lang": "vi",
      "themeColor": "#2B3990",
      "backgroundColor": "#F8F9FC"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B3990",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "description": "Học cờ vua cho trẻ em theo lộ trình 6 cấp Tốt → Mã → Tượng → Xe → Hậu → Vua — Vui trí tuệ."
  }
}
