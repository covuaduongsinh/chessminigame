{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "export:web": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_*", "EXPO_BASE_URL"]
    }
  },
  "globalPassThroughEnv": ["CHROMIUM_PATH"]
}
